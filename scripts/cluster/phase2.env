# Phase 2 settings, sourced by every job script. Edit for your cluster and budget.
export SWARM_DIR=${SWARM_DIR:-$HOME/drone-swarm-search}   # the repository checkout
export VENV=${VENV:-$SWARM_DIR/.venv}
export RUN=${RUN:-runs/phase2}                            # outputs, relative to SWARM_DIR

# Missions: families trained on (flood stays held out), growing areas and long operations (K2)
export FAMILIES="${FAMILIES:-wilderness urban}"
export EXPAND_SHARE=${EXPAND_SHARE:-0.3}
export LONG_SHARE=${LONG_SHARE:-0.3}

# Imitation of the rule (DAgger): missions per round, rounds set by BETAS
export IMITATE_EPISODES=${IMITATE_EPISODES:-2000}
export BETAS="${BETAS:-1.0 0.5 0.25 0.0}"

# Reinforcement learning from the sharpened copy, with the KL pull towards it kept on
export SEEDS="${SEEDS:-0 1 2}"
export RL_STEPS=${RL_STEPS:-100000000}
export N_ENVS=${N_ENVS:-128}            # missions in flight per update
export BC_COEF=${BC_COEF:-0.3}
export BC_ANNEAL=${BC_ANNEAL:-1000000}     # a fraction of training > 1 keeps the pull on throughout
export ENT_COEF=${ENT_COEF:-0.001}
export CKPT_EVERY=${CKPT_EVERY:-25}

# Evaluation
export EVAL_EPISODES=${EVAL_EPISODES:-200}
