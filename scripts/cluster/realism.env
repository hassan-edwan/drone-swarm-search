# Settings for the realism jobs (docs/REALISM.md), sourced by realism_*.sbatch after phase2.env.
export ARDUPILOT=${ARDUPILOT:-$SWARM_DIR/tools/ardupilot}   # arducopter SITL binary and copter.parm
export REAL_RUN=${REAL_RUN:-runs/realism}                    # outputs, relative to SWARM_DIR

# 1. realism evaluation: missions per variant and world (scripts/eval_realism.py)
export REAL_EPISODES=${REAL_EPISODES:-500}
# 2. ArduPilot flights: missions on the hamlet site, wind speeds (m/s), simulator steps per mission
export SITL_SEEDS=${SITL_SEEDS:-0-99}
export SITL_WINDS="${SITL_WINDS:-0 5 10}"
export SITL_STEPS=${SITL_STEPS:-60}
# 3. the target-choosing policy retrained under the new defaults (always in contact,
#    calibrated sensing, under-canopy checks), then evaluated against the rule
export T_ITERS=${T_ITERS:-400}
export T_EPISODES=${T_EPISODES:-64}
export T_EVAL_EPISODES=${T_EVAL_EPISODES:-300}
export T_CONDITIONS="${T_CONDITIONS:-wild_mix urban_mix flood_mix_heldout wild_real_catoctin wild_real_hamlet}"
# 4. map vs real world: real-world draws and under-canopy checks per draw (x 8 variants)
export SURPRISE_WORLDS=${SURPRISE_WORLDS:-16}
export SURPRISE_CHECKS=${SURPRISE_CHECKS:-100}
